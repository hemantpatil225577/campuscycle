# CampusCycle Environment Variables
# Cloud SQL (PostgreSQL) & Firebase Auth are auto-configured in AI Studio.
# You do NOT need Supabase keys or an Admin Passcode.

# Auto-injected by AI Studio Cloud SQL provisioning (only fill manually if self-hosting outside AI Studio)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Optional: restrict student logins to a specific college email suffix (e.g. ".edu" or ".ac.in")
# Leave empty to allow any Gmail / email account.
ALLOWED_COLLEGE_DOMAIN=

# Optional: primary administrator email (defaults to the configured project owner email)
ADMIN_EMAIL=
